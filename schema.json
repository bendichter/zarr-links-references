{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Links and Object References Convention",
  "description": "Schema for the Links and Object References Zarr convention: links in groups, and arrays whose elements or struct fields are object references",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version"
    },
    "node_type": {
      "type": "string",
      "enum": ["array", "group"],
      "description": "Type of Zarr node"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          }
        },
        "links_references": {
          "$ref": "#/$defs/linksReferences"
        }
      },
      "required": ["zarr_conventions"]
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "allOf": [
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "links_references": {
                "type": "object",
                "required": ["links"]
              }
            },
            "required": ["links_references"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "group"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "zarr_conventions": {
                "type": "array",
                "contains": {
                  "$ref": "#/$defs/refConventionMetadata"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "links_references": {
                "type": "object",
                "properties": {
                  "references": {
                    "const": true
                  }
                },
                "required": ["references"]
              }
            },
            "required": ["links_references"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "array"
          },
          "data_type": {
            "$ref": "#/$defs/stringDataType"
          }
        },
        "required": ["data_type"]
      }
    },
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "links_references": {
                "type": "object",
                "properties": {
                  "references": {
                    "type": "array"
                  }
                },
                "required": ["references"]
              }
            },
            "required": ["links_references"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "array"
          },
          "data_type": {
            "type": "object",
            "properties": {
              "name": {
                "const": "struct"
              }
            },
            "required": ["name"]
          }
        },
        "required": ["data_type"]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Links and Object References convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/zarr-conventions/links-references/refs/tags/v1/schema.json",
          "description": "URL to the JSON Schema definition for this convention"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/zarr-conventions/links-references/blob/v1/README.md",
          "description": "URL to the full specification document"
        },
        "uuid": {
          "type": "string",
          "const": "93624424-4c95-4eda-b86a-f1880206739f",
          "description": "UUID that permanently identifies this convention"
        },
        "name": {
          "type": "string",
          "const": "links_references",
          "description": "Human-readable name of the convention, matching its nesting key"
        },
        "description": {
          "type": "string",
          "const": "Links and object references between nodes of Zarr hierarchies",
          "description": "Brief description of the convention's purpose and usage"
        }
      },
      "anyOf": [
        {
          "required": ["schema_url"]
        },
        {
          "required": ["spec_url"]
        },
        {
          "required": ["uuid"]
        }
      ],
      "additionalProperties": false
    },
    "refConventionMetadata": {
      "type": "object",
      "description": "The convention metadata object of the ref convention, which link targets use",
      "properties": {
        "uuid": {
          "const": "d89b30cf-ed8c-43d5-9a16-b492f0cd8786"
        }
      },
      "required": ["uuid"]
    },
    "linksReferences": {
      "type": "object",
      "description": "Properties of the Links and Object References convention",
      "properties": {
        "links": {
          "type": "object",
          "description": "The links held by this group, by name",
          "propertyNames": {
            "minLength": 1,
            "not": {
              "pattern": "/"
            }
          },
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/linkTarget"
          }
        },
        "references": {
          "description": "true if each element of the array is an object reference; for a struct array, the names of the fields that are",
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "linkTarget": {
      "type": "object",
      "description": "A ref convention object (v2.0.0) that identifies a node. A link targets a whole node, so the ref attribute field is not allowed",
      "properties": {
        "ref": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "description": "URI of another store that holds the target"
            },
            "node": {
              "type": "string",
              "description": "Path of the target: relative to this group within this store, absolute in another store"
            }
          },
          "required": ["node"],
          "additionalProperties": false,
          "if": {
            "required": ["uri"]
          },
          "then": {
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "else": {
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[^/]"
              }
            }
          }
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "stringDataType": {
      "description": "A Zarr v3 string data type: variable-length or fixed-length",
      "oneOf": [
        {
          "const": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "fixed_length_utf32"
            }
          },
          "required": ["name"]
        }
      ]
    }
  }
}
