{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Links and Object References Convention",
  "description": "Schema for the Links and Object References Zarr convention: links in groups, arrays of object references, reference fields of struct arrays, and references in attributes",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version"
    },
    "node_type": {
      "type": "string",
      "enum": ["array", "group"],
      "description": "Type of Zarr node"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          }
        },
        "_LINKS": {
          "type": "array",
          "description": "Links held by this group",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "_REFERENCE_FIELDS": {
          "type": "array",
          "description": "Names of the fields of a struct array that hold object references",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["zarr_conventions"],
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      }
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "allOf": [
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "required": ["_LINKS"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "group"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "_DTYPE": {
                "const": "object_reference"
              }
            },
            "required": ["_DTYPE"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "array"
          },
          "data_type": {
            "$ref": "#/$defs/stringDataType"
          }
        },
        "required": ["data_type"]
      }
    },
    {
      "if": {
        "properties": {
          "attributes": {
            "type": "object",
            "required": ["_REFERENCE_FIELDS"]
          }
        },
        "required": ["attributes"]
      },
      "then": {
        "properties": {
          "node_type": {
            "const": "array"
          },
          "data_type": {
            "type": "object",
            "properties": {
              "name": {
                "const": "struct"
              }
            },
            "required": ["name"]
          }
        },
        "required": ["data_type"]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Links and Object References convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/zarr-conventions/links-references/refs/tags/v1/schema.json",
          "description": "URL to the JSON Schema definition for this convention"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/zarr-conventions/links-references/blob/v1/README.md",
          "description": "URL to the full specification document"
        },
        "uuid": {
          "type": "string",
          "const": "93624424-4c95-4eda-b86a-f1880206739f",
          "description": "UUID that permanently identifies this convention"
        },
        "name": {
          "type": "string",
          "const": "links-references",
          "description": "Human-readable name of the convention"
        },
        "description": {
          "type": "string",
          "const": "Links and object references between nodes of Zarr hierarchies",
          "description": "Brief description of the convention's purpose and usage"
        }
      },
      "anyOf": [
        {
          "required": ["schema_url"]
        },
        {
          "required": ["spec_url"]
        },
        {
          "required": ["uuid"]
        }
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "description": "Identifies a node: the hierarchy that holds it and its path within that hierarchy",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "The root of the hierarchy that holds the target, as a URI reference resolved against the root of this hierarchy; '.' for this hierarchy"
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute path of the target within that hierarchy"
        }
      },
      "required": ["source", "path"]
    },
    "link": {
      "type": "object",
      "description": "A link: a named child of a group that is another node",
      "allOf": [
        {
          "$ref": "#/$defs/target"
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "/"
          },
          "description": "Name of the link within the group"
        },
        "source": true,
        "path": true
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "attributeReference": {
      "type": "object",
      "description": "An object reference stored as an attribute value",
      "properties": {
        "_REFERENCE": {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/target"
            }
          ],
          "properties": {
            "source": true,
            "path": true
          },
          "additionalProperties": false
        }
      },
      "required": ["_REFERENCE"],
      "additionalProperties": false
    },
    "attributeValue": {
      "description": "Any attribute value. An object with a _REFERENCE key must be a reference, and so must every object with a _REFERENCE key in an array of them",
      "if": {
        "type": "object",
        "required": ["_REFERENCE"]
      },
      "then": {
        "$ref": "#/$defs/attributeReference"
      },
      "else": {
        "if": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": ["_REFERENCE"]
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attributeReference"
          }
        }
      }
    },
    "stringDataType": {
      "description": "A Zarr v3 string data type: variable-length or fixed-length",
      "oneOf": [
        {
          "const": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "fixed_length_utf32"
            }
          },
          "required": ["name"]
        }
      ]
    }
  }
}
